# Copie para .env e preencha.

# Endereço do biplas_server_claude, sem o /api. O endereço definido na aba
# Configurações do programa tem prioridade sobre este.
BIPLAS_SERVER_URL=http://localhost:3000

# Mesma chave do API_KEY no .env do servidor (enviada no header x-api-key).
BIPLAS_API_KEY=

# Pasta das planilhas Excel exportadas.
SAIDA_DIR=relatorios
